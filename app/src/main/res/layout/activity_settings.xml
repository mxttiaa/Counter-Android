<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity"
    tools:ignore="VisualLintSystemUi">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="4dp"
        android:background="@color/steelBlue"
        android:minHeight="?attr/actionBarSize"
        app:title="Impostazioni"
        app:titleTextColor="@color/deepSpaceBlue"

        app:navigationIcon="@drawable/outline_arrow_back_ios_new_24"
        app:navigationIconTint="@color/deepSpaceBlue"

        app:layout_constraintTop_toTopOf="parent" />

    <!-- SEZIONE VALORE DI INCREMENTO (GAP) -->
    <TextView
        android:id="@+id/lbl_gap_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valore di incremento"
        android:textColor="@color/deepSpaceBlue"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_gap_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_gap_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_minus_gap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Diminuisci salto"
            android:text=""
            app:icon="@drawable/remove_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="25dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/steelBlue"
            app:iconTint="@color/deepSpaceBlue"
            app:strokeWidth="3dp"
            app:strokeColor="@color/deepSpaceBlue" />

        <TextView
            android:id="@+id/txt_gap_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="1"
            android:textSize="32sp"
            android:textColor="@color/deepSpaceBlue"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_plus_gap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Aumenta salto"
            android:text=""
            app:icon="@drawable/add_2_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="25dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/steelBlue"
            app:iconTint="@color/deepSpaceBlue"
            app:strokeWidth="3dp"
            app:strokeColor="@color/deepSpaceBlue" />

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:background="@color/deepSpaceBlue"
        android:alpha="0.2"
        app:layout_constraintTop_toBottomOf="@id/layout_gap_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SEZIONE CAMBIO COLORE AUTOMATICO -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_color_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cambio colore automatico"
        android:textColor="@color/deepSpaceBlue"
        android:textSize="18sp"
        android:checked="true"
        android:layout_marginTop="20dp"

        app:thumbTint="@color/deepSpaceBlue"
        app:trackTint="@color/frostedBlue"

        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:id="@+id/lbl_interval_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cambia colore ogni"
        android:textColor="@color/deepSpaceBlue"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/switch_color_change"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_interval_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_interval_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_minus_interval"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Diminuisci intervallo"
            android:text=""
            app:icon="@drawable/remove_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="25dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/steelBlue"
            app:iconTint="@color/deepSpaceBlue"
            app:strokeWidth="3dp"
            app:strokeColor="@color/deepSpaceBlue" />

        <TextView
            android:id="@+id/txt_interval_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="10"
            android:textSize="32sp"
            android:textColor="@color/deepSpaceBlue"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_plus_interval"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Aumenta intervallo"
            android:text=""
            app:icon="@drawable/add_2_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="25dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/steelBlue"
            app:iconTint="@color/deepSpaceBlue"
            app:strokeWidth="3dp"
            app:strokeColor="@color/deepSpaceBlue" />

    </LinearLayout>

    <View
        android:id="@+id/divider_color"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:background="@color/deepSpaceBlue"
        android:alpha="0.2"
        app:layout_constraintTop_toBottomOf="@id/layout_interval_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NUOVA SEZIONE: COLORE FISSO DI SFONDO -->
    <TextView
        android:id="@+id/lbl_main_color_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Colore principale"
        android:textColor="@color/deepSpaceBlue"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/divider_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_main_color_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_main_color_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_prev_color"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Colore precedente"
            android:text=""
            app:icon="@drawable/outline_arrow_back_ios_new_24"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="25dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/steelBlue"
            app:iconTint="@color/deepSpaceBlue"
            app:strokeWidth="3dp"
            app:strokeColor="@color/deepSpaceBlue" />

        <TextView
            android:id="@+id/txt_color_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="Colore 1"
            android:textSize="22sp"
            android:textColor="@color/deepSpaceBlue"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_next_color"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Colore successivo"
            android:text=""
            app:icon="@drawable/outline_arrow_back_ios_new_24"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="25dp"
            android:rotation="180"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/steelBlue"
            app:iconTint="@color/deepSpaceBlue"
            app:strokeWidth="3dp"
            app:strokeColor="@color/deepSpaceBlue" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>